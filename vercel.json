{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/:path*.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/catalogues",
      "destination": "/index.html"
    },
    {
      "source": "/portal",
      "destination": "/index.html"
    },
    {
      "source": "/corporate",
      "destination": "/corporate.html"
    },
    {
      "source": "/company",
      "destination": "/corporate.html"
    },
    {
      "source": "/website",
      "destination": "/corporate.html"
    },
    {
      "source": "/wardrobe",
      "destination": "/Capsule_Interiors_Wardrobe_Catalogue.pdf"
    },
    {
      "source": "/modular-kitchen",
      "destination": "/Capsule_Interiors_Modular_Kitchen_Catalogue.pdf"
    },
    {
      "source": "/kitchen",
      "destination": "/Capsule_Interiors_Modular_Kitchen_Catalogue.pdf"
    },
