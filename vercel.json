{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/wardrobe", "destination": "/Capsule_Interiors_Wardrobe_Catalogue.pdf" },
    { "source": "/modular-kitchen", "destination": "/Capsule_Interiors_Modular_Kitchen_Catalogue.pdf" },
    { "source": "/kitchen", "destination": "/Capsule_Interiors_Modular_Kitchen_Catalogue.pdf" },
    { "source": "/bedrooms", "destination": "/Capsule_Interiors_Kids_Bed_Catalogue.pdf" },
    { "source": "/beds", "destination": "/Capsule_Interiors_Kids_Bed_Catalogue.pdf" },
    { "source": "/kids-bed", "destination": "/Capsule_Interiors_Kids_Bed_Catalogue.pdf" },
    { "source": "/tv-units", "destination": "/Capsule_Interiors_TV_Unit_Catalogue.pdf" },
    { "source": "/tv-unit", "destination": "/Capsule_Interiors_TV_Unit_Catalogue.pdf" },
    { "source": "/bar-counter", "destination": "/Capsule_Interiors_Bar_Counter_Catalogue.pdf" },
    { "source": "/temple-space", "destination": "/Capsule_Interiors_Temple_Design_Catalogue.pdf" },
    { "source": "/temple", "destination": "/Capsule_Interiors_Temple_Design_Catalogue.pdf" },
    { "source": "/pop-ceiling", "destination": "/Capsule_Interiors_POP_Design_Catalogue.pdf" },
    { "source": "/pop", "destination": "/Capsule_Interiors_POP_Design_Catalogue.pdf" },
    { "source": "/ceiling", "destination": "/Capsule_Interiors_Ceiling_Design_Catalogue.pdf" },
    { "source": "/crockery-unit", "destination": "/Capsule_Interiors_Concrete_Unit_Catalogue.pdf" },
    { "source": "/company-brochure", "destination": "/Capsule_Company_Official_Brochure.pdf" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
